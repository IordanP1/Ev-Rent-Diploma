@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}
<div class="auth-page">
    <div class="auth-card">

        <h2>🔐 Вход в EV Rent</h2>
        <p class="auth-subtitle">
            Влезте в своя профил
        </p>

        <form id="account"
              method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"  role="alert"> </div>

            <div class="form-floating mb-3"> <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email"> Имейл  </label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3"> <input asp-for="Input.Password"  class="form-control"  autocomplete="current-password"  placeholder="password" />
                <label asp-for="Input.Password"> Парола </label>
                <span asp-validation-for="Input.Password" class="text-danger"> </span>
            </div>

            <div class="checkbox mb-3">
                <label> <input class="form-check-input"  asp-for="Input.RememberMe" /> Запомни ме </label>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-success">  Вход  </button>
            <div class="text-center mt-3"> <a asp-page="./Register"> Регистрация </a>  </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}