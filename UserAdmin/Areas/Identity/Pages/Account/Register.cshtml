@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}


<div class="auth-page">
    <div class="auth-card">

        <h2>📝 Регистрация в EV Rent</h2>

        <p class="auth-subtitle">
            Създайте нов профил
        </p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert">
            </div>

            <div class="form-floating mb-3"> <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email">
                    Имейл
                </label>

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Парола" />

                <label asp-for="Input.Password">
                    Парола
                </label>

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Потвърди парола" />

                <label asp-for="Input.ConfirmPassword">
                    Потвърди парола
                </label>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-success"> Регистрирай се </button>

            <div class="text-center mt-3">
                <a asp-page="./Login">
                    Имате профил? Вход
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
