@{
    ViewData["Title"] = "Прогнозен пробег";
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<div class="range-page">
    <div class="range-card">
        <h2>🔋 EV Калкулатор</h2>

        <p class="range-subtitle">
            Изчисли прогнозния пробег според батерията, разхода, режима на шофиране и условията на експлоатация.
        </p>

        <form method="post">
            <label>Капацитет на батерията (kWh)</label>
            <input type="number" step="0.1" name="batteryCapacityKwh" class="form-control mb-3" min="1" required />

            <label>Текущ заряд (%)</label>
            <input type="number" name="batteryLevelPercent" class="form-control mb-3" min="0" max="100" required />

            <label>Среден разход (kWh/100km)</label>
            <input type="number" step="any" name="averageConsumption" class="form-control mb-3" required />
            <label>Режим на шофиране</label>
            <select name="drivingMode" class="form-control mb-3">
                <option value="normal">Нормален</option>
                <option value="eco">Икономичен</option>
                <option value="sport">Спортен</option>
            </select>

            <label>Натоварване на автомобила</label>
            <select name="load" class="form-control mb-3">
                <option value="light">Леко</option>
                <option value="normal" selected>Нормално</option>
                <option value="heavy">Тежко</option>
            </select>

            <label>Допълнителни условия</label>

            <div class="form-check mb-2">
                <input type="radio" name="conditionMode" value="none" class="form-check-input" checked />
                <label class="form-check-label">Няма</label>
            </div>

            <div class="form-check mb-2">
                <input type="radio" name="conditionMode" value="climate" class="form-check-input" />
                <label class="form-check-label">Климатик / отопление</label>
            </div>

            <div class="form-check mb-4">
                <input type="radio" name="conditionMode" value="winter" class="form-check-input" />
                <label class="form-check-label">Зимен режим</label>
            </div>

            <button type="submit" class="btn btn-success w-100">
                Изчисли пробег
            </button>
        </form>

        @if (ViewBag.Result != null)
        {
            <div class="range-result mt-4">
                <h3>Резултат</h3>

                <p>Базов пробег: <strong>@ViewBag.BaseRange km</strong></p>
                <p>Прогнозен реалистичен пробег: <strong>@ViewBag.Result km</strong></p>
                <p>
                    Безопасен пробег:
                    <strong>@ViewBag.SafeRange km</strong>
                </p>

                <small>
                    Безопасният пробег включва 15% резерв в батерията и намалява риска от
                    пълното ѝ разреждане.
                </small>
            </div>
        }
    </div>
</div>