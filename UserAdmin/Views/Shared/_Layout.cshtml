<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EV Rent</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EvRent.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
 
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                        <a class="navbar-brand custom-logo"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                            <img src="~/images/logo.png" alt="EV Rent Logo" />

                        </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Cars" asp-action="Index">Автомобили</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"  asp-controller="Rentals" asp-action="MyRentals">Моите наеми</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Range" asp-action="Index"> Прогнозен пробег</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="ChargingStationsPage" asp-action="Index"> Зарядни станции </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Администрация</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>  

    <div class="toast-container position-fixed top-0 end-0 p-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast show custom-toast success-toast">
                <div class="toast-body">
                    ✅ @TempData["SuccessMessage"]
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast show custom-toast error-toast">
                <div class="toast-body">
                    ❌ @TempData["ErrorMessage"]
                </div>
            </div>
        }
    </div>

    <script>
            setTimeout(() => {
                document.querySelectorAll('.custom-toast').forEach(t => {
                    t.style.opacity = '0';
                    t.style.transition = '0.4s';
                    setTimeout(() => t.remove(), 400);
                });
            }, 3000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

